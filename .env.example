# Copy this file to .env and fill in real values before running the app.

# Flask secret key used for sessions / flash messages. Use a long random string in production.
SECRET_KEY=change-this-to-a-random-secret-key

# SQLite database location (relative to project root). No changes needed for local dev.
DATABASE_URL=sqlite:///app.db

# Set to "1" to enable Flask debug mode locally. NEVER enable this in production
# (it can expose tracebacks to users).
FLASK_DEBUG=0
